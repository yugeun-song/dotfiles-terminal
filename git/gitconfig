# Shared settings, no identity: user.name/user.email are set by hand in
# ~/.gitconfig, which includes this file. Credentials come only from gh; the
# empty `helper =` clears any inherited helper (e.g. plaintext `store`).

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[core]
	editor = nvim

[init]
	defaultBranch = main

[pull]
	# Fail on divergence instead of creating a surprise merge commit.
	ff = only
