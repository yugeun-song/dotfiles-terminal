// Whole Arch logo (both slots $1 and $2) in #1793D1, 24-bit. `0;` drops the
// bold fastfetch adds. `modules` is required: a config file replaces the
// defaults, and without it only the logo prints.
{
    "logo": {
        "color": {
            "1": "0;38;2;23;147;209",
            "2": "0;38;2;23;147;209"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
