# Keeps `npm install -g` and `yarn global` out of pacman's /usr/lib/node_modules;
# yarn reads this variable, not ~/.npmrc.
export npm_config_prefix="$HOME/.local"

# User bin directories go last, so a name pacman owns resolves to the packaged
# copy (a `cargo install` duplicate cannot shadow it); an override in
# ~/.local/bin no longer wins. ~/.cargo/env and ~/.ghcup/env prepend, so they
# are not sourced. Here, not in zshrc, so scripts resolve alike. Each
# directory is removed first: `typeset -U` keeps the first occurrence, which a
# parent shell may have put in front.
typeset -U path
for _userbin in "$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/.elan/bin" "$HOME/.ghcup/bin"; do
    path=("${(@)path:#$_userbin}")
    [[ -d $_userbin ]] && path+=("$_userbin")
done
unset _userbin

# Per-tool drop-ins, only from files this user owns that group and others
# cannot write.
for _f in "${XDG_CONFIG_HOME:-$HOME/.config}"/profile.d/*.sh(N.U^IW); do
    . "$_f"
done
unset _f
