# Keeps `npm install -g` and `yarn global` out of pacman's /usr/lib/node_modules;
# yarn reads this variable, not ~/.npmrc.
export npm_config_prefix="$HOME/.local"

# User bin directories last (shell/path.sh, shared with bash). Here, not in
# zshrc, so scripts resolve alike.
typeset -U path
[[ -r ${XDG_CONFIG_HOME:-$HOME/.config}/shell/path.sh ]] && . ${XDG_CONFIG_HOME:-$HOME/.config}/shell/path.sh

# Per-tool drop-ins, only from files this user owns that group and others
# cannot write.
for _f in "${XDG_CONFIG_HOME:-$HOME/.config}"/profile.d/*.sh(N.U^IW); do
    . "$_f"
done
unset _f
