# Keep `npm install -g` and `yarn global` out of pacman-owned
# /usr/lib/node_modules. The variable, unlike ~/.npmrc, is read by yarn too.
export npm_config_prefix="$HOME/.local"

# User-level bin dirs go last, so a name pacman owns always resolves to the
# packaged copy (e.g. a `cargo install` duplicate of a repo binary cannot
# shadow it). Cost: an override in ~/.local/bin no longer wins. ~/.cargo/env
# is not sourced because it prepends. Here, not in zshrc, so scripts resolve
# the same way. Each dir is removed first: `typeset -U` keeps the first
# occurrence, so a dir a parent shell put in front would otherwise stay there.
typeset -U path
for _userbin in "$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/.elan/bin"; do
    path=("${(@)path:#$_userbin}")
    [[ -d $_userbin ]] && path+=("$_userbin")
done
unset _userbin

# Per-tool drop-ins; only files owned by this user and not group/other-writable.
for _f in "${XDG_CONFIG_HOME:-$HOME/.config}"/profile.d/*.sh(N.U^IW); do
    . "$_f"
done
unset _f
