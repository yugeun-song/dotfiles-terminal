# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh


# --- Vi mode: hjkl editing on the command line ---
bindkey -v
export KEYTIMEOUT=1
export EDITOR=nvim
export VISUAL=nvim

autoload -Uz add-zle-hook-widget edit-command-line

# Cursor shape per mode (block=normal, beam=insert); p10k shows the text label
_vi_mode_cursor() {
  case $KEYMAP in
    vicmd) printf '\033[2 q' ;;
    *)     printf '\033[6 q' ;;
  esac
}
add-zle-hook-widget keymap-select _vi_mode_cursor
add-zle-hook-widget line-init      _vi_mode_cursor

# Ctrl-O inserts a newline instead of running the command.
# No ESC prefix, so it can't be absorbed into the Esc -> normal-mode switch.
_insert_newline() { LBUFFER+=$'\n'; }
zle -N _insert_newline
bindkey -M viins '^O' _insert_newline
bindkey -M vicmd '^O' _insert_newline

# Keep the emacs keys that make insert mode livable
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^H' backward-delete-char
bindkey -M viins '^A' beginning-of-line
bindkey -M viins '^E' end-of-line
bindkey -M viins '^K' kill-line
bindkey -M viins '^U' backward-kill-line
bindkey -M viins '^W' backward-kill-word
bindkey -M viins '^P' up-line-or-history
bindkey -M viins '^N' down-line-or-history

# Normal mode: / and ? search history; Ctrl-X Ctrl-E edits the line in $EDITOR.
# v is left as vi visual-mode so the VISUAL state stays reachable.
bindkey -M vicmd '/' history-incremental-search-backward
bindkey -M vicmd '?' history-incremental-search-forward
zle -N edit-command-line
bindkey -M viins '^X^E' edit-command-line
bindkey -M vicmd '^X^E' edit-command-line

# fzf sourced AFTER vi mode so Ctrl-R / Ctrl-T survive bindkey -v
[ -f /usr/share/fzf/key-bindings.zsh ] && source /usr/share/fzf/key-bindings.zsh
[ -f /usr/share/fzf/completion.zsh ] && source /usr/share/fzf/completion.zsh

