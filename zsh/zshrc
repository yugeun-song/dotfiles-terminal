# p10k instant prompt. Anything that may prompt for input must go above this.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
    git
    zsh-syntax-highlighting
    zsh-autosuggestions
)

source $ZSH/oh-my-zsh.sh

# After oh-my-zsh.sh, whose 10000 cap silently evicts old entries. Loading
# 500000 is slower, but the instant prompt hides it.
HISTSIZE=500000
SAVEHIST=500000
HISTFILE="$HOME/.zsh_history"

# Ctrl-R walks distinct commands; other history options come from Oh My Zsh.
setopt HIST_REDUCE_BLANKS
setopt HIST_FIND_NO_DUPS

# Prompt config is seeded from zsh/p10k.zsh; `p10k configure` edits the copy.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh


# --- Vi mode: hjkl editing on the command line ---
bindkey -v
export KEYTIMEOUT=1
export EDITOR=nvim
export VISUAL=nvim

[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/shell/man.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/man.sh"

autoload -Uz add-zle-hook-widget edit-command-line

# Cursor shape per mode (block=normal, beam=insert); p10k shows the text label
_vi_mode_cursor() {
  case $KEYMAP in
    vicmd) printf '\033[2 q' ;;
    *)     printf '\033[6 q' ;;
  esac
}
add-zle-hook-widget keymap-select _vi_mode_cursor
add-zle-hook-widget line-init      _vi_mode_cursor

# Ctrl-O inserts a newline instead of running the command.
# No ESC prefix, so it can't be absorbed into the Esc -> normal-mode switch.
_insert_newline() { LBUFFER+=$'\n'; }
zle -N _insert_newline
bindkey -M viins '^O' _insert_newline
bindkey -M vicmd '^O' _insert_newline

# Keep the emacs keys that make insert mode livable
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^H' backward-delete-char
bindkey -M viins '^A' beginning-of-line
bindkey -M viins '^E' end-of-line
bindkey -M viins '^K' kill-line
bindkey -M viins '^U' backward-kill-line
bindkey -M viins '^W' backward-kill-word
bindkey -M viins '^P' up-line-or-history
bindkey -M viins '^N' down-line-or-history

# Normal mode: / and ? search history; Ctrl-X Ctrl-E edits the line in $EDITOR.
# v is left as vi visual-mode so the VISUAL state stays reachable.
bindkey -M vicmd '/' history-incremental-search-backward
bindkey -M vicmd '?' history-incremental-search-forward
zle -N edit-command-line
bindkey -M viins '^X^E' edit-command-line
bindkey -M vicmd '^X^E' edit-command-line

# Vi-mode yanks also go to the first clipboard backend that works.
_clipboard_backends() {
    local -a b
    [[ -n $WAYLAND_DISPLAY ]] && (( $+commands[wl-copy] )) && b+=(wl-copy)
    [[ -n $DISPLAY ]] && (( $+commands[xclip] )) && b+=(xclip)
    [[ -n $DISPLAY ]] && (( $+commands[xsel] )) && b+=(xsel)
    (( $+commands[pbcopy] )) && b+=(pbcopy)
    [[ -n $TMUX ]] && (( $+commands[tmux] )) && b+=(tmux)
    [[ -w /dev/tty ]] && (( $+commands[base64] )) &&
        [[ $TERM == (xterm-kitty|foot*|alacritty|wezterm|xterm-ghostty) ||
           $TERM_PROGRAM == (iTerm.app|WezTerm|ghostty) ]] && b+=(osc52)
    print -r -- $b
}
_clipboard_pipe() {
    if (( $+commands[timeout] )); then
        print -rn -- "$1" | timeout 2 "${@:2}" >/dev/null 2>&1
    else
        print -rn -- "$1" | "${@:2}" >/dev/null 2>&1
    fi
}
_cutbuffer_to_clipboard() {
    local data=$CUTBUFFER backend enc
    [[ -n $data ]] || return 0
    for backend in ${=$(_clipboard_backends)}; do
        case $backend in
            wl-copy) _clipboard_pipe "$data" wl-copy && return 0 ;;
            xclip)   _clipboard_pipe "$data" xclip -selection clipboard && return 0 ;;
            xsel)    _clipboard_pipe "$data" xsel --clipboard --input && return 0 ;;
            pbcopy)  _clipboard_pipe "$data" pbcopy && return 0 ;;
            tmux)    _clipboard_pipe "$data" tmux load-buffer -w - && return 0 ;;
            osc52)
                enc=$(print -rn -- "$data" | base64 | tr -d '\n') || continue
                (( ${#enc} <= 100000 )) || continue
                printf '\e]52;c;%s\a' "$enc" 2>/dev/null >/dev/tty && return 0 ;;
        esac
    done
    return 0
}
if [[ -n $(_clipboard_backends) ]]; then
    _vi_yank_clip()            { zle .vi-yank            && _cutbuffer_to_clipboard }
    _vi_yank_whole_line_clip() { zle .vi-yank-whole-line && _cutbuffer_to_clipboard }
    _vi_yank_eol_clip()        { zle .vi-yank-eol        && _cutbuffer_to_clipboard }
    zle -N vi-yank            _vi_yank_clip
    zle -N vi-yank-whole-line _vi_yank_whole_line_clip
    zle -N vi-yank-eol        _vi_yank_eol_clip
fi

# fzf sourced AFTER vi mode so Ctrl-R / Ctrl-T survive bindkey -v
[ -f /usr/share/fzf/key-bindings.zsh ] && source /usr/share/fzf/key-bindings.zsh
[ -f /usr/share/fzf/completion.zsh ] && source /usr/share/fzf/completion.zsh

# Colors from Spaceduck (https://github.com/pineapplegiant/spaceduck),
# matching kitty/spaceduck.conf.
export FZF_DEFAULT_OPTS='
--layout=reverse
--height=50%
--border=rounded
--margin=1,5
--prompt="🔍 "
--pointer="▶"
--color=bg:#0F111B,bg+:#1B1C36,fg:#ECF0C1,fg+:#FFFFFF
--color=hl:#5CCC96,hl+:#5CCC96,info:#F2CE00,border:#686F9A,header:#B3A1E6
--color=prompt:#F2CE00,pointer:#5CCC96,marker:#E39400,spinner:#F2CE00
'

alias peaclock-spotify='peaclock --config ~/.peaclock/config/color_spotify'
alias peaclock-cyan='peaclock --config ~/.peaclock/config/color_cyan'
alias peaclock-dracula='peaclock --config ~/.peaclock/config/color_dracula_purple'
alias peaclock-emerald='peaclock --config ~/.peaclock/config/color_emerald'

alias unimatrix-safe='unimatrix -g black -c green -s 90 -a -n'

alias el='eza --icons -al'

alias glow='glow -w $(tput cols)'

# Piping into nvim keeps ANSI colors (baleia renders SGR as highlights).
# Only kicks in for a bare `cmd | nvim`; `nvim file` is untouched.
nvim() {
  if [[ ! -t 0 && $# -eq 0 ]]; then
    command nvim -c 'lua pcall(function() if vim.api.nvim_buf_line_count(0) <= 100000 then require("baleia").setup({}).once(0) else vim.notify("baleia: input too large; run :BaleiaColorize manually", vim.log.levels.WARN) end end)' -
  else
    command nvim "$@"
  fi
}

[[ ! -f ~/.config/zsh/caps-lock.zsh ]] || source ~/.config/zsh/caps-lock.zsh

# debug-max (managed): maximum-visibility debugging helpers
[ -f "$HOME/.config/debug-max/debug-max.sh" ] && . "$HOME/.config/debug-max/debug-max.sh"

# >>> gdbtools/kbuildlab private env (managed) >>>
# Per-machine private settings for gdbtools/kbuildlab. The files under
# ~/.config/{gdbtools,kbuildlab}/env are untracked; keep private values there,
# not in the public checkouts. Absent files are a no-op.
for _f in "${XDG_CONFIG_HOME:-$HOME/.config}/gdbtools/env" \
          "${XDG_CONFIG_HOME:-$HOME/.config}/kbuildlab/env"; do
    [ -r "$_f" ] && . "$_f"
done
unset _f
# <<< gdbtools/kbuildlab private env (managed) <<<
