_gdb_dev_run() {
    emulate -L zsh
    local arch_gdb="$1" cc_fn="$2"
    shift 2
    local target="$1"
    if [[ -z "$target" ]]; then
        echo "usage: ${funcstack[2]} <source.c|.S|binary> [args...]" >&2
        return 1
    fi
    shift

    local bin="$target"
    case "${target:e}" in
        c|C|s|S)
            if [[ -z "$cc_fn" ]] || ! typeset -f "$cc_fn" >/dev/null; then
                echo "error: no dev compiler for '$arch_gdb'; pass a prebuilt binary" >&2
                return 1
            fi
            "$cc_fn" "$target" || return
            bin="${${target:t}:r}"
            ;;
    esac

    bin="${bin:A}"
    if [[ ! -x "$bin" ]]; then
        echo "error: '$bin' not found or not executable" >&2
        return 1
    fi

    if ! command -v tmux >/dev/null; then
        echo "error: tmux is required for the all-in-one interactive debug" >&2
        return 1
    fi

    local port
    for port in 55555 55556 55557 55558 55559; do
        ss -Hltn "sport = :$port" 2>/dev/null | grep -q . || break
    done

    local run_cmd="QEMU_GDB=$port ${(q)bin} ${(j: :)${(q)@}}"
    local hold='; echo; echo "[guest exited - press enter to close]"; read _'

    if [[ -n "$TMUX" ]]; then
        local guest_pane
        guest_pane=$(tmux split-window -hdP -F '#{pane_id}' -l 45% "$run_cmd$hold")
        sleep 0.2
        gdb "$bin" \
            -ex "set arch $arch_gdb" \
            -ex "target remote :$port" \
            -ex 'b _start'
        tmux kill-pane -t "$guest_pane" 2>/dev/null
    else
        local sess="armdbg$$"
        local gdb_cmd="gdb ${(q)bin} -ex 'set arch $arch_gdb' -ex 'target remote :$port' -ex 'b _start'"
        tmux new-session  -d -s "$sess" "$run_cmd$hold"
        tmux split-window -h -t "$sess" "sleep 0.3; $gdb_cmd; tmux kill-session -t $sess"
        tmux select-pane  -t "$sess" -R
        tmux attach -t "$sess"
        tmux kill-session -t "$sess" 2>/dev/null
    fi
}

gdb-arm64-dev() { _gdb_dev_run 'aarch64'    'gcc-arm64-dev' "$@"; }
gdb-rv64-dev()  { _gdb_dev_run 'riscv:rv64' ''              "$@"; }

_ARM64_DEV_COMMON=(-O0 -fno-pie -fno-omit-frame-pointer -fno-stack-protector -fno-jump-tables -mbranch-protection=none -fno-asynchronous-unwind-tables -fno-unwind-tables)
_ARM64_DEV_EXE=($_ARM64_DEV_COMMON -g3 -gdwarf-5 -static -no-pie)
_ARM64_DEV_ASM=($_ARM64_DEV_COMMON -fverbose-asm)
_ARM64_DEV_FREE=(-nostdlib -static -no-pie -g)

gcc-arm64-dev() {
    emulate -L zsh
    local cc=aarch64-linux-gnu-gcc
    if (( $# < 1 )) || [[ ! -f "$1" ]]; then
        echo "usage: gcc-arm64-dev <source.c|.S|.s> [extra gcc args]" >&2
        return 1
    fi
    local src="$1"; shift
    local out="${${src:t}:r}"
    case "${src:e}" in
        c)
            $cc $_ARM64_DEV_EXE "$src" "$@" -o "$out" || return
            $cc $_ARM64_DEV_ASM -S "$src" "$@" -o "$out.s" || return
            echo "built: $out  (+ $out.s)"
            ;;
        S|s)
            if grep -qE '(\.globa?l[[:space:]]+_start|^[[:space:]]*_start[[:space:]]*:)' "$src"; then
                $cc $_ARM64_DEV_FREE "$src" "$@" -o "$out" || return
            else
                $cc $_ARM64_DEV_EXE "$src" "$@" -o "$out" || return
            fi
            echo "built: $out"
            ;;
        *)
            echo "gcc-arm64-dev: unsupported source '$src'" >&2
            return 1
            ;;
    esac
    echo "run: ./$out   |   debug: gdb-arm64-dev ./$out"
}

run-arm64-dev() {
    emulate -L zsh
    if (( $# < 1 )) || [[ ! -x "$1" ]]; then
        echo "usage: run-arm64-dev <aarch64-binary> [args]" >&2
        return 1
    fi
    local bin="${1:A}"; shift
    "$bin" "$@"
}

alias glow='glow -w $(tput cols)'

# Piping into nvim keeps ANSI colors (baleia renders SGR as highlights).
# Only kicks in for a bare `cmd | nvim`; `nvim file` is untouched.
nvim() {
  if [[ ! -t 0 && $# -eq 0 ]]; then
    command nvim -c 'lua pcall(function() if vim.api.nvim_buf_line_count(0) <= 100000 then require("baleia").setup({}).once(0) else vim.notify("baleia: input too large; run :BaleiaColorize manually", vim.log.levels.WARN) end end)' -
  else
    command nvim "$@"
  fi
}

