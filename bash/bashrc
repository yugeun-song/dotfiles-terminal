# Fedora and RHEL build bash without a system bashrc and leave /etc/bashrc to
# this file, as their /etc/skel/.bashrc does (completion, command-not-found,
# vte.sh); Arch, Debian and openSUSE read theirs themselves and have none.
[ -r /etc/bashrc ] && . /etc/bashrc

# Before the guard: a non-interactive login bash reads this too, through the
# ~/.bash_profile from /etc/skel. User bin directories last, as in zsh
# (shell/path.sh). Debian's and Ubuntu's ~/.profile puts ~/.local/bin in front
# after sourcing this, so a login bash there keeps it first.
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/shell/path.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/path.sh"

[[ $- != *i* ]] && return

# Without histappend the last bash to exit overwrites every other session's
# history. zsh is the login shell; bash covers rescue shells and containers.
HISTSIZE=500000
HISTFILESIZE=500000
HISTCONTROL=ignoreboth
HISTTIMEFORMAT='%F %T '
shopt -s histappend
shopt -s cmdhist

alias ls='ls --color=auto'
alias grep='grep --color=auto'
# el is bin/el on PATH; the alias stands in only while that is not installed.
if ! command -v el >/dev/null 2>&1 && command -v eza >/dev/null 2>&1; then
    alias el='eza --icons -al'
fi
PS1='[\u@\h \W]\$ '
# As zshenv: drop-ins this user owns that group and others cannot write.
for _f in "${XDG_CONFIG_HOME:-$HOME/.config}"/profile.d/*.sh; do
    [ -f "$_f" ] && [ -O "$_f" ] && [ -z "$(find "$_f" -maxdepth 0 -perm /022 2>/dev/null)" ] && . "$_f"
done
unset _f
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/shell/man.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/man.sh"
[ -r "$HOME/.config/byobu/prompt" ] && . "$HOME/.config/byobu/prompt"   #byobu-prompt#

# debug-max (managed): maximum-visibility debugging helpers
[ -f "$HOME/.config/debug-max/debug-max.sh" ] && . "$HOME/.config/debug-max/debug-max.sh"

# >>> gdbtools/kbuildlab private env (managed) >>>
# Per-machine private settings for gdbtools/kbuildlab. The files under
# ~/.config/{gdbtools,kbuildlab}/env are untracked; keep private values there,
# not in the public checkouts. Absent files are a no-op.
for _f in "${XDG_CONFIG_HOME:-$HOME/.config}/gdbtools/env" \
          "${XDG_CONFIG_HOME:-$HOME/.config}/kbuildlab/env"; do
    [ -r "$_f" ] && . "$_f"
done
unset _f
# <<< gdbtools/kbuildlab private env (managed) <<<
