#
# ~/.bashrc
#

# PATH before the guard below. A login bash reads this file through
# ~/.bash_profile even when it is not interactive, and the guard returns first.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# History
#
# Bash ships with 500 entries and no histappend, which means the last shell to
# exit overwrites the file with only its own session and every other open
# terminal's history goes with it. zsh is the login shell here and holds the
# real history; this exists so the bash sessions that do happen -- a rescue
# shell, a container, a script run interactively -- do not discard theirs.
HISTSIZE=500000
HISTFILESIZE=500000
HISTCONTROL=ignoreboth
HISTTIMEFORMAT='%F %T '
shopt -s histappend
shopt -s cmdhist

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '
[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/shell/man.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/man.sh"
[ -r $HOME/.config/byobu/prompt ] && . $HOME/.config/byobu/prompt   #byobu-prompt#
. "$HOME/.cargo/env"

# debug-max (managed): maximum-visibility debugging helpers
[ -f "$HOME/.config/debug-max/debug-max.sh" ] && . "$HOME/.config/debug-max/debug-max.sh"

# >>> gdbtools/kbuildlab private env (managed) >>>
# Per-machine private settings for gdbtools/kbuildlab. The files under
# ~/.config/{gdbtools,kbuildlab}/env are untracked; keep private values there,
# not in the public checkouts. Absent files are a no-op.
for _f in "${XDG_CONFIG_HOME:-$HOME/.config}/gdbtools/env" \
          "${XDG_CONFIG_HOME:-$HOME/.config}/kbuildlab/env"; do
    [ -r "$_f" ] && . "$_f"
done
unset _f
# <<< gdbtools/kbuildlab private env (managed) <<<
