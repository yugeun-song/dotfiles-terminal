#!/bin/sh
# `eza --icons -al` with eza's output untouched, for any user and under sudo,
# which finds the root-owned copy in /usr/local/bin. Nothing in the invoking
# user's home is read or run, so root only ever runs root-owned code.

nl='
'

warn() {
    printf 'el: %s\n' "$*" >&2
}

tried=$nl
reason=

# An eza that cannot start, such as one whose shared library a partial upgrade
# replaced, fails --version before printing anything; the next one is tried.
usable() {
    [ -n "$1" ] || return 1
    case $tried in
        *"$nl$1$nl"*) return 1 ;;
    esac
    tried=$tried$1$nl
    [ -f "$1" ] && [ -x "$1" ] || return 1
    out=$("$1" --version 2>&1 >/dev/null)
    code=$?
    [ "$code" -eq 0 ] && return 0
    [ -n "$reason" ] || reason=${out%%"$nl"*}
    [ -n "$reason" ] || reason="$1 exited with status $code"
    return 1
}

try_eza() {
    usable "$1" || return 0
    bin=$1
    shift
    exec "$bin" --icons -al "$@"
}

[ -n "${PATH-}" ] || PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# sudo can drop LS_COLORS. Rebuild it as Oh My Zsh does, reading ~/.dircolors
# only when it is a regular file owned by the user running el.
if [ -z "${LS_COLORS-}" ] && command -v dircolors >/dev/null 2>&1; then
    colors=
    own=
    case ${HOME-} in
        /*) [ -f "$HOME/.dircolors" ] && own=$(find "$HOME/.dircolors" -prune -type f -user "$(id -u)" 2>/dev/null) ;;
    esac
    if [ -n "$own" ]; then
        colors=$(dircolors -b -- "$own" 2>/dev/null) || colors=
    fi
    [ -n "$colors" ] || colors=$(dircolors -b 2>/dev/null) || colors=
    [ -n "$colors" ] && eval "$colors"
fi

try_eza "$(command -v eza 2>/dev/null)" "$@"
try_eza /usr/local/bin/eza "$@"
try_eza /usr/bin/eza "$@"

if [ -n "$reason" ]; then
    warn "eza cannot run ($reason); falling back to ls"
else
    warn "eza not found; falling back to ls"
fi

if ! command -v ls >/dev/null 2>&1; then
    warn "ls not found either"
    exit 127
fi

if [ -n "${NO_COLOR+x}" ]; then
    exec ls -lAh "$@"
elif ls --color=auto -d / >/dev/null 2>&1; then
    exec ls --color=auto -lAh "$@"
elif ls -G -d / >/dev/null 2>&1; then
    exec ls -G -lAh "$@"
fi
exec ls -lAh "$@"
